{
  "name": "drovr",
  "version": "0.1.0",
  "description": "CLI that picks up Linear tickets and puts your Herdr agents to work.",
  "license": "MIT",
  "author": "Yannick Stachelscheid",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yss14/drovr.git"
  },
  "homepage": "https://github.com/yss14/drovr#readme",
  "bugs": {
    "url": "https://github.com/yss14/drovr/issues"
  },
  "keywords": [
    "cli",
    "linear",
    "herdr",
    "codex",
    "claude-code",
    "coding-agent",
    "git-worktree",
    "automation"
  ],
  "type": "module",
  "bin": {
    "drovr": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
