{
  "workflow": "eng-agent-ready",
  "pollIntervalSeconds": 60,
  "maxConcurrent": 1,
  "firstRun": "dispatch",
  "tickets": {
    "provider": "linear",
    "team": "ENG",
    "labels": [
      "agent-ready"
    ],
    "excludeLabels": [],
    "states": [
      "Todo"
    ],
    "assignee": "any"
  },
  "completion": {
    "stateTypes": [
      "completed",
      "canceled"
    ],
    "states": [
      "In Review"
    ],
    "whenWorkspaceClosed": true
  },
  "repositories": [
    {
      "path": "~/code/my-repo",
      "vcs": "auto",
      "worktreePath": "{repo}/.worktrees/{branchSlug}",
      "setup": []
    }
  ],
  "terminal": {
    "provider": "herdr",
    "session": "main",
    "focus": false
  },
  "agent": {
    "provider": "codex",
    "args": [],
    "env": {}
  }
}
